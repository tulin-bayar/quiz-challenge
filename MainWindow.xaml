<Window x:Class="QuizChallenge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Challenge"
        Width="900"
        Height="740"
        MinWidth="700"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        FontFamily="Segoe UI"
        Foreground="#F8FAFC">

    <Window.Resources>

        <!-- Answer cards -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DCE3F0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="AnswerBorder"
                                Background="#182238"
                                BorderBrush="#2A3650"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="ChoiceBadge"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="9"
                                        Background="#25324A"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AnswerBorder"
                                        Property="Background"
                                        Value="#222E47"/>
                                <Setter TargetName="AnswerBorder"
                                        Property="BorderBrush"
                                        Value="#7180A0"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AnswerBorder"
                                        Property="Background"
                                        Value="#302653"/>
                                <Setter TargetName="AnswerBorder"
                                        Property="BorderBrush"
                                        Value="#A78BFA"/>
                                <Setter TargetName="ChoiceBadge"
                                        Property="Background"
                                        Value="#7C3AED"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AnswerBorder"
                                        Property="BorderBrush"
                                        Value="#C4B5FD"/>
                                <Setter TargetName="AnswerBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#C4B5FD"
                                BorderThickness="0"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#8B5CF6"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#6D28D9"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="40,30"
              MaxWidth="780"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Quiz Challenge"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>

                    <TextBlock Text="A little focus. A new high score."
                               FontSize="14"
                               Foreground="#9AAAC4"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#1B2540"
                        CornerRadius="10"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="TECH EDITION"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#C4B5FD"/>
                </Border>
            </Grid>

            <!-- Main card -->
            <Border Grid.Row="1"
                    Background="#111A2D"
                    BorderBrush="#25314A"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="30">

                <Grid>

                    <StackPanel x:Name="QuizPanel">

                        <Border Background="#292344"
                                CornerRadius="8"
                                Padding="12,6"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="ProgressText"
                                       Text="Question 1/10"
                                       Foreground="#D4C5FF"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock x:Name="QuestionText"
                                   Text="Your question will appear here."
                                   Foreground="#F8FAFC"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,20,0,8"/>

                        <TextBlock Text="Choose one answer to continue."
                                   Foreground="#9AAAC4"
                                   FontSize="14"
                                   Margin="0,0,0,24"/>

                        <RadioButton x:Name="Option0"
                                     GroupName="Answers"
                                     Tag="A"
                                     Content="Option A"/>

                        <RadioButton x:Name="Option1"
                                     GroupName="Answers"
                                     Tag="B"
                                     Content="Option B"/>

                        <RadioButton x:Name="Option2"
                                     GroupName="Answers"
                                     Tag="C"
                                     Content="Option C"/>

                        <RadioButton x:Name="Option3"
                                     GroupName="Answers"
                                     Tag="D"
                                     Content="Option D"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="FeedbackText"
                                       Foreground="#FDA4AF"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,18,0"/>

                            <Button x:Name="NextButton"
                                    Grid.Column="1"
                                    Content="Next"
                                    MinWidth="140"/>
                        </Grid>

                    </StackPanel>

                    <!-- Results -->
                    <StackPanel x:Name="ResultPanel"
                                Visibility="Collapsed"
                                Margin="0,24">

                        <Border Width="80"
                                Height="80"
                                CornerRadius="40"
                                Background="#163D3B"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#x2713;"
                                       FontSize="42"
                                       Foreground="#5EEAD4"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Challenge completed"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,22,0,8"/>

                        <TextBlock Text="Every attempt is a step forward."
                                   FontSize="15"
                                   Foreground="#9AAAC4"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <Border Background="#182238"
                                CornerRadius="16"
                                Padding="28"
                                Margin="0,28,0,26">
                            <TextBlock x:Name="ResultText"
                                       Foreground="#E9E4FF"
                                       FontSize="23"
                                       LineHeight="38"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button x:Name="RestartButton"
                                Content="Restart"
                                MinWidth="180"
                                HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Take your time. Test your knowledge."
                       Foreground="#9AAAC4"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>

        </Grid>
    </ScrollViewer>
</Window>