<Window x:Class="QuizChallenge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Challenge"
        Width="900"
        Height="740"
        MinWidth="700"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#20211F"
        FontFamily="Segoe UI"
        Foreground="#E9DFC9">

    <Window.Resources>

        <!-- Answer options -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E9DFC9"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="AnswerBorder"
                                Background="#30312D"
                                BorderBrush="#505149"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="18,15">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="ChoiceBadge"
                                        Width="30"
                                        Height="30"
                                        CornerRadius="4"
                                        BorderBrush="#77776A"
                                        BorderThickness="1"
                                        Background="Transparent"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">

                                    <TextBlock x:Name="ChoiceLetter"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AnswerBorder"
                                        Property="Background"
                                        Value="#393A34"/>
                                <Setter TargetName="AnswerBorder"
                                        Property="BorderBrush"
                                        Value="#A69F8D"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AnswerBorder"
                                        Property="Background"
                                        Value="#393A34"/>
                                <Setter TargetName="AnswerBorder"
                                        Property="BorderBrush"
                                        Value="#E9DFC9"/>
                                <Setter TargetName="ChoiceBadge"
                                        Property="Background"
                                        Value="#E9DFC9"/>
                                <Setter TargetName="ChoiceBadge"
                                        Property="BorderBrush"
                                        Value="#E9DFC9"/>
                                <Setter TargetName="ChoiceLetter"
                                        Property="Foreground"
                                        Value="#20211F"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AnswerBorder"
                                        Property="BorderBrush"
                                        Value="#E9DFC9"/>
                                <Setter TargetName="AnswerBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E9DFC9"/>
            <Setter Property="Foreground" Value="#20211F"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <Grid>
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <Border x:Name="FocusBorder"
                                        BorderBrush="#20211F"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Margin="-20,-6"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
            Property="Background"
            Value="#F1E8D6"/>
                                <Setter Property="Foreground"
            Value="#20211F"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
            Property="Background"
            Value="#CFC3AC"/>
                                <Setter Property="Foreground"
            Value="#20211F"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="40,30"
              MaxWidth="780"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="Quiz Challenge"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24"/>

            <!-- Main area -->
            <Border Grid.Row="1"
                    Background="#282925"
                    BorderBrush="#45463F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="30">

                <Grid>
                    <!-- Welcome screen -->
                    <StackPanel x:Name="WelcomePanel"
            Visibility="Collapsed"
            Margin="0,45">

                        <TextBlock Text="Welcome to Quiz Challenge"
               FontSize="30"
               FontWeight="SemiBold"
               Foreground="#E9DFC9"
               TextAlignment="Center"
               TextWrapping="Wrap"/>

                        <TextBlock x:Name="WelcomeDescriptionText"
               FontSize="16"
               Foreground="#BDB5A3"
               TextAlignment="Center"
               TextWrapping="Wrap"
               LineHeight="28"
               Margin="0,20,0,36"/>

                        <Button x:Name="StartButton"
            Content="Start Quiz"
            MinWidth="180"
            HorizontalAlignment="Center"/>

                    </StackPanel>
                    <StackPanel x:Name="QuizPanel"
                        Visibility="Collapsed">

                        <TextBlock x:Name="ProgressText"
                                   Text="Question 1/10"
                                   Foreground="#BDB5A3"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="QuestionText"
                                   Text="Your question will appear here."
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,8"/>

                        <TextBlock Text="Choose one answer to continue."
                                   Foreground="#BDB5A3"
                                   FontSize="14"
                                   Margin="0,0,0,24"/>

                        <RadioButton x:Name="Option0"
                                     GroupName="Answers"
                                     Tag="A"
                                     Content="Option A"/>

                        <RadioButton x:Name="Option1"
                                     GroupName="Answers"
                                     Tag="B"
                                     Content="Option B"/>

                        <RadioButton x:Name="Option2"
                                     GroupName="Answers"
                                     Tag="C"
                                     Content="Option C"/>

                        <RadioButton x:Name="Option3"
                                     GroupName="Answers"
                                     Tag="D"
                                     Content="Option D"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BackButton"
            Grid.Column="0"
            Content="Exit"
            MinWidth="100"
            Background="#393A34"
            Foreground="#E9DFC9"/>

                            <TextBlock x:Name="FeedbackText"
               Grid.Column="1"
               Foreground="#E9DFC9"
               FontSize="13"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               Margin="18,0"/>

                            <Button x:Name="NextButton"
            Grid.Column="2"
            Content="Next"
            MinWidth="130"/>
                        </Grid>

                    </StackPanel>

                    <!-- Results -->
                    <StackPanel x:Name="ResultPanel"
                                Visibility="Collapsed"
                                Margin="0,30">

                        <TextBlock Text="Quiz completed"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Your result"
                                   FontSize="15"
                                   Foreground="#BDB5A3"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0"/>

                        <Border Background="#30312D"
                                BorderBrush="#505149"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="28"
                                Margin="0,26,0,28">

                            <TextBlock x:Name="ResultText"
                                       Foreground="#E9DFC9"
                                       FontSize="24"
                                       LineHeight="38"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button x:Name="RestartButton"
                                Content="Restart"
                                MinWidth="160"
                                HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>